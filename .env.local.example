# Copie ce fichier en ".env.local" et remplis les valeurs
# depuis Firebase Console > Parametres du projet > Vos applications > SDK config

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optionnel, pour les notifications push web (Firebase Cloud Messaging)
# Firebase Console > Cloud Messaging > Certificats web push > Generer une paire de cles
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Optionnel, non utilise en local (next dev) : le module IA (fonctionnalites Gemini
# de la page Stock) tourne uniquement via la Cloudflare Pages Function functions/api/ai.ts,
# une fois deploye. La cle ne se met PAS ici mais dans le tableau de bord Cloudflare
# (Workers & Pages > ton projet > Settings > Environment variables), nom EXACT : GEMINI_API_KEY.
# Obtiens une cle gratuite sur https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Non utilise actuellement (le module IA passe par Gemini, voir ci-dessus)
OPENAI_API_KEY=
