rules_version = '2';

// Photos de preuve : stockees sous families/{familyId}/tasks/{taskId}/...
// Seuls les utilisateurs authentifies rattaches a cette famille (via /users/{uid})
// peuvent lire ou deposer des fichiers.

service firebase.storage {
  match /b/{bucket}/o {
    match /families/{familyId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.familyId == familyId;
    }
  }
}
